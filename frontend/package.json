{
	"name": "dayu-frontend",
	"version": "2.4.33",
	"type": "module",
	"description": "Dayu system frontend for cloud-edge collaborative stream data analysis",
	"author": "Dayu AutoStreamer Contributors",
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"test": "node --test tests/*.test.mjs",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx,.vue src/",
		"lint:fix": "npm run lint -- --fix",
		"lint-fix": "npm run lint:fix",
		"format": "prettier --write \"{src,public,tests}/**/*.{js,mjs,jsx,ts,tsx,vue,scss,css,json,md}\"",
		"format:check": "prettier --check \"{src,public,tests}/**/*.{js,mjs,jsx,ts,tsx,vue,scss,css,json,md}\""
	},
	"dependencies": {
		"@dagrejs/dagre": "^1.1.4",
		"@element-plus/icons-vue": "^2.1.0",
		"@vue-flow/background": "^1.3.2",
		"@vue-flow/controls": "^1.1.2",
		"@vue-flow/core": "^1.42.1",
		"@vue-flow/minimap": "^1.5.2",
		"axios": "^1.12.0",
		"echarts": "^5.4.2",
		"element-plus": "^2.11.0",
		"js-cookie": "^3.0.1",
		"mitt": "^3.0.0",
		"nprogress": "^0.2.0",
		"pinia": "^2.0.34",
		"qs": "^6.14.1",
		"sortablejs": "^1.15.0",
		"vue": "^3.2.47",
		"vue-demi": "^0.13.11",
		"vue-i18n": "^9.14.5",
		"vue-router": "^4.1.6"
	},
	"devDependencies": {
		"@types/node": "^18.19.75",
		"@types/nprogress": "^0.2.0",
		"@types/sortablejs": "^1.15.1",
		"@typescript-eslint/eslint-plugin": "^5.58.0",
		"@typescript-eslint/parser": "^5.58.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vue/compiler-sfc": "^3.2.47",
		"eslint": "^8.38.0",
		"eslint-plugin-vue": "^9.10.0",
		"less": "^4.2.0",
		"prettier": "^2.8.7",
		"sass": "^1.61.0",
		"typescript": "^5.7.3",
		"vite": "^6.4.1",
		"vite-plugin-cdn-import": "^0.3.5",
		"vite-plugin-compression": "^0.5.1",
		"vite-plugin-environment": "^1.1.3",
		"vue-eslint-parser": "^9.1.1"
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead"
	],
	"engines": {
		"node": ">=20.0.0",
		"npm": ">= 7.0.0"
	},
	"keywords": [
		"dayu",
		"cloud-edge",
		"stream-analysis",
		"scheduler",
		"vue",
		"vue3",
		"element-plus"
	],
	"repository": {
		"type": "github",
		"url": "https://github.com/dayu-autostreamer/dayu"
	}
}
